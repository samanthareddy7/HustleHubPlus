
{
  "info": {
    "name": "HustleHub+ Complete API Testing",
    "description": "Automated success, failure, validation, authentication and role-based security tests for the HustleHub+ backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "https://localhost:4000"},
    {"key": "password", "value": "Testing123!"},
    {"key": "clientEmail", "value": ""},
    {"key": "freelancerEmail", "value": ""},
    {"key": "secondFreelancerEmail", "value": ""},
    {"key": "clientToken", "value": ""},
    {"key": "freelancerToken", "value": ""},
    {"key": "secondFreelancerToken", "value": ""},
    {"key": "adminToken", "value": ""},
    {"key": "gigId", "value": ""},
    {"key": "bookingId", "value": ""},
    {"key": "missingId", "value": "000000000000000000000000"}
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "if (name.startsWith('01 ')) {",
          "  pm.collectionVariables.set('clientEmail', 'client' + Date.now() + '@example.com');",
          "  pm.collectionVariables.unset('clientToken');",
          "}",
          "if (name.startsWith('02 ')) {",
          "  pm.collectionVariables.set('freelancerEmail', 'freelancer' + Date.now() + '@example.com');",
          "  pm.collectionVariables.unset('freelancerToken');",
          "}",
          "if (name.startsWith('03 ')) {",
          "  pm.collectionVariables.set('secondFreelancerEmail', 'secondfreelancer' + Date.now() + '@example.com');",
          "  pm.collectionVariables.unset('secondFreelancerToken');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const name = pm.info.requestName;",
          "const statusMatch = name.match(/\\[(\\d{3})\\]$/);",
          "if (statusMatch) {",
          "  pm.test('Expected HTTP status ' + statusMatch[1], function () {",
          "    pm.response.to.have.status(Number(statusMatch[1]));",
          "  });",
          "}",
          "pm.test('Response contains valid JSON', function () {",
          "  pm.response.to.be.json;",
          "  pm.response.json();",
          "});",
          "if (pm.response.code >= 400) {",
          "  pm.test('Error does not expose server stack traces', function () {",
          "    pm.expect(pm.response.text()).to.not.include('at Layer.handle');",
          "    pm.expect(pm.response.text()).to.not.include('node_modules/');",
          "  });",
          "}",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "  const data = pm.response.json();",
          "  if (name.includes('Login Client')) {",
          "    pm.test('Client JWT returned', function () {",
          "      pm.expect(data.token).to.be.a('string').and.not.empty;",
          "    });",
          "    pm.collectionVariables.set('clientToken', data.token);",
          "  }",
          "  if (name.includes('Login Freelancer')) {",
          "    pm.test('Freelancer JWT returned', function () {",
          "      pm.expect(data.token).to.be.a('string').and.not.empty;",
          "    });",
          "    pm.collectionVariables.set('freelancerToken', data.token);",
          "  }",
          "  if (name.includes('Login Second Freelancer')) {",
          "    pm.test('Second freelancer JWT returned', function () {",
          "      pm.expect(data.token).to.be.a('string').and.not.empty;",
          "    });",
          "    pm.collectionVariables.set('secondFreelancerToken', data.token);",
          "  }",
          "  if (name.includes('Register')) {",
          "    pm.test('Password hash is not returned', function () {",
          "      pm.expect(data.user).to.not.have.property('passwordHash');",
          "    });",
          "  }",
          "  if (name.includes('Create Gig Successfully')) {",
          "    pm.test('Created gig has an ID', function () {",
          "      pm.expect(data.gig._id).to.be.a('string');",
          "    });",
          "    pm.collectionVariables.set('gigId', data.gig._id);",
          "  }",
          "  if (name.includes('Create Booking Successfully')) {",
          "    pm.test('Booking and transaction created', function () {",
          "      pm.expect(data.booking._id).to.be.a('string');",
          "      pm.expect(data.transaction._id).to.be.a('string');",
          "      pm.expect(data.booking.status).to.eql('Pending');",
          "    });",
          "    pm.collectionVariables.set('bookingId', data.booking._id);",
          "  }",
          "  if (name.includes('Complete Booking Successfully')) {",
          "    pm.test('Booking is completed', function () {",
          "      pm.expect(data.booking.status).to.eql('Completed');",
          "    });",
          "  }",
          "  if (name.includes('View Freelancer Income')) {",
          "    pm.test('Financial summary exists', function () {",
          "      pm.expect(data.summary).to.have.property('totalIncome');",
          "      pm.expect(data.summary).to.have.property('estimatedTax');",
          "      pm.expect(data.summary).to.have.property('netIncome');",
          "      pm.expect(data.transactions).to.be.an('array');",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
